# Twilio Verify (create a Verify Service in the Twilio Console)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional test-only local stub. Never enable in production.
# OTP_PROVIDER=stub
# OTP_STUB_CODE=123456

# Cashfree SANDBOX credentials (Merchant Dashboard -> Developers -> API Keys -> Sandbox)
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key

# SANDBOX (test money) or PRODUCTION (real money; needs KYC-approved account)
CASHFREE_ENV=SANDBOX

# Cashfree Verification suite (PAN / GSTIN / bank / UPI name-match).
# Used for KYC and beneficiary verification when set. From the Cashfree
# Verification / Secure ID dashboard.
CASHFREE_VERIFY_CLIENT_ID=your_verification_client_id
CASHFREE_VERIFY_CLIENT_SECRET=your_verification_client_secret

# Cashfree Payouts (disburses to payee bank/UPI). From the Payouts dashboard.
# When set, payouts go through Cashfree; base URL follows CASHFREE_ENV.
CASHFREE_PAYOUT_CLIENT_ID=your_payout_client_id
CASHFREE_PAYOUT_CLIENT_SECRET=your_payout_client_secret
# CASHFREE_PAYOUT_BASE_URL=   # override only if Cashfree gives you a custom host

# KYC provider: 'cashfree' (default when verify creds set), 'hyperverge', or stub.
# KYC_PROVIDER=cashfree

PORT=8080
