# Twilio Verify (create a Verify Service in the Twilio Console)
OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace_with_your_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional test-only local stub. Never enable in production.
# OTP_PROVIDER=stub
# OTP_STUB_CODE=123456

# Cashfree SANDBOX credentials (Merchant Dashboard -> Developers -> API Keys -> Sandbox)
CASHFREE_APP_ID=your_sandbox_app_id
CASHFREE_SECRET_KEY=your_sandbox_secret_key

# SANDBOX (test money) or PRODUCTION (real money; needs KYC-approved account)
CASHFREE_ENV=SANDBOX

# Cashfree Payouts is a separately activated product with separate API keys.
# Use STUB only for local/test runs; production requires CASHFREE and Secrets Manager values.
PAYOUT_PROVIDER=stub
CASHFREE_PAYOUT_CLIENT_ID=your_payout_client_id
CASHFREE_PAYOUT_CLIENT_SECRET=your_payout_client_secret
# SANDBOX: https://sandbox.cashfree.com/payout
# PRODUCTION: https://api.cashfree.com/payout
CASHFREE_PAYOUT_BASE_URL=https://sandbox.cashfree.com/payout
CASHFREE_PAYOUT_MODE=imps

# Local PostgreSQL (production DATABASE_URL comes from AWS Secrets Manager).
DATABASE_URL=postgres://xorpay:local_password@localhost:5432/xorpay
DATABASE_SSL=false
DATABASE_POOL_SIZE=10

# Required when persisting bank/UPI beneficiaries. Generate a random 32-byte key
# and base64 encode it; keep it in Secrets Manager, never commit the value.
BENEFICIARY_ENCRYPTION_KEY_ID=v1
BENEFICIARY_ENCRYPTION_KEY=replace_with_base64_encoded_32_byte_key
# In production, TLS is mandatory; optionally set the RDS CA bundle here.
# DATABASE_SSL_CA=-----BEGIN CERTIFICATE-----...\n-----END CERTIFICATE-----

JWT_SECRET=local_development_secret_replace_with_32_bytes_minimum
# Optional in local dev (falls back to in-memory refresh sessions); required in production.
# REDIS_URL=redis://localhost:6379

PORT=8080

# Limited-pilot controls (store the phone allowlist in AWS Secrets Manager)
PILOT_MODE=false
PILOT_ALLOWLIST_PHONES=
PILOT_ALLOWED_CATEGORIES=vendor,rent
PILOT_MAX_USERS=10
# Internal pilot defaults: ₹5,000/transaction; ₹10,000/day; ₹50,000/month, in paise.
PILOT_MAX_TRANSACTION_MINOR=500000
PILOT_MAX_DAILY_MINOR=1000000
PILOT_MAX_MONTHLY_MINOR=5000000

# Cashfree PG refund API version/base. Refund create uses a stable refund ID and
# idempotency key; production values must match the Cashfree account configuration.
CASHFREE_PG_API_VERSION=2023-08-01
CASHFREE_PG_BASE_URL=https://sandbox.cashfree.com/pg
